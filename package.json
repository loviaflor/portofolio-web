{
  "name": "maria-astro-theme",
  "description": "A free Astro portfolio theme for UX and product designers, with MDX case studies, a resume page, light and dark modes, and cookie consent.",
  "type": "module",
  "version": "3.0.1",
  "author": "Andrei Alba",
  "license": "MIT",
  "private": true,
  "keywords": [
    "astro-theme",
    "astro",
    "portfolio",
    "ux",
    "ui",
    "product-design",
    "designer",
    "case-study",
    "resume",
    "mdx",
    "tailwindcss"
  ],
  "homepage": "https://maria.xocoweb.workers.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xocothemes/maria.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "release:check": "npm run check && npm run build && npm run format:check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "dependencies": {
