---
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { resume } from '@/config/resume';
---

<section id="skills" class="shell mt-20 sm:mt-28" aria-labelledby="skills-title">
  <SectionHead id="skills-title" eyebrow="Skills" title="Skills and experience" />

    <div class="reveal mt-10 flex">
      <a
        class="btn btn-primary"
        href="https://docs.google.com/document/d/1Qp7A5vrvzAhwdB1TEMm_fTeequsezWopZy6R7rBYUnU/edit?usp=sharing"
        target="_blank"
        rel="noopener noreferrer"
      >
        View Full Resume
        <Icon name="arrow-up-right" class="icon-nudge-diagonal size-4" />
      </a>
    </div>

  <div class="mt-12">
    <div class="resume-row reveal">
      <h3 class="eyebrow self-start">Capabilities</h3>
      <ul class="grid gap-8 sm:grid-cols-3">
        {resume.capabilities.map((item) => (
          <li>
            <h4 class="font-semibold">{item.title}</h4>
            <p class="mt-2 text-muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="resume-row reveal">
      <h3 class="eyebrow self-start">Experience</h3>
      <ol class="grid gap-10">
        {resume.experience.map((job) => (
          <li class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-x-8">
            <h4 class="text-title">
              {job.role}
              <span class="text-muted">, {job.company}</span>
            </h4>
            <p class="text-sm text-muted sm:row-start-1 sm:col-start-2 sm:pt-1.5">{job.period}</p>
            <p class="max-w-2xl text-body">{job.text}</p>
          </li>
        ))}
      </ol>
    </div>

    {resume.tools.length > 0 && (
      <div class="resume-row reveal">
        <h3 class="eyebrow self-start">Tools</h3>
        <ul class="grid grid-cols-3 gap-3">
          {resume.tools.map((tool) => (
            <li class="flex items-center gap-3 rounded-panel border border-line bg-surface p-3.5">
              <span class="grid size-11 place-items-center rounded-xl border border-line bg-sunken">
                <Image src={tool.logo} alt="" class="size-6 object-contain" />
              </span>
              <span class="font-medium">{tool.name}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

  
  </div>
</section>

<style>
  .resume-row {
    display: grid;
    gap: 1.5rem;
    padding-block: 3rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 64rem) {
    .resume-row {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 4rem;
    }
  }
</style>