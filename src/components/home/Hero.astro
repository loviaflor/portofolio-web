---
import { Image } from 'astro:assets';
import photo from '@/assets/images/about-saya.jpeg';
import Icon from '@/components/ui/Icon.astro';
import { hero } from '@/config/home';
---

<section id="home" class="shell pt-14 pb-20 sm:pt-20 sm:pb-28 lg:pt-24" aria-labelledby="hero-title">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center lg:gap-16">
    <div>
      <h1 id="hero-title" class="rise max-w-[17ch] text-headline">
        {hero.greeting} {hero.firstName} {hero.otherNames}
      </h1>
      <p class="rise mt-8 max-w-xl text-lead text-body" style="--rise-step: 2">{hero.text}</p>
      <div class="rise mt-8 flex flex-wrap gap-3" style="--rise-step: 3">
        <a class="btn btn-primary" href={hero.primary.href}>
          {hero.primary.label}
          <Icon name="arrow-right" class="icon-nudge size-4" />
        </a>
        <a class="btn btn-ghost" href={hero.secondary.href}>
          {hero.secondary.label}
        </a>
      </div>
    </div>
    <div class="rise" style="--rise-step: 2">
      <Image
        src={photo}
        alt="Portrait of Lovia"
        widths={[320, 480, 640]}
        sizes="(min-width: 64rem) 22rem, 90vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-4/5 w-full rounded-card object-cover object-top"
      />
    </div>
  </div>
</section>